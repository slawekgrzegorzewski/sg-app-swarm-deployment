require "base64"
require "fileutils"

Vagrant.configure("2") do |config|
  ssh_dir = File.expand_path(".ssh", __dir__)
  nodes = [
    { name: "swarm-manager",  hostname: "pc2",  ip: "192.168.56.10", mac: "080027A10001" },
    { name: "swarm-worker-1", hostname: "rpi5", ip: "192.168.56.11", mac: "080027A10002" },
    { name: "swarm-worker-2", hostname: "rpi4", ip: "192.168.56.12", mac: "080027A10003" },
    { name: "swarm-worker-3", hostname: "rpi3", ip: "192.168.56.13", mac: "080027A10004" }
  ]

  FileUtils.mkdir_p(ssh_dir)
  key_pairs = nodes.map do |node|
    key_name = "vagrant_#{node[:hostname]}_ed25519"
    private_key_path = File.join(ssh_dir, key_name)
    public_key_path = "#{private_key_path}.pub"

    if File.exist?(private_key_path) != File.exist?(public_key_path)
      abort "Niepełna para kluczy SSH: #{key_name}. Uzupełnij brakujący plik albo usuń oba pliki tej pary."
    end

    unless File.exist?(private_key_path)
      unless system("ssh-keygen", "-q", "-t", "ed25519", "-f", private_key_path, "-N", "", "-C", "slawek@#{node[:hostname]}")
        abort "Nie udało się wygenerować pary kluczy SSH #{key_name}."
      end
    end

    {
      name: node[:name],
      key_name: key_name,
      private_key_path: private_key_path,
      public_key_path: public_key_path
    }
  end

  authorized_keys = key_pairs
    .map { |key_pair| File.read(key_pair[:public_key_path], encoding: "UTF-8").strip }
    .join("\n")
  encoded_authorized_keys = Base64.strict_encode64("#{authorized_keys}\n")

  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false
  # DHCP na karcie mostkowanej może wydłużyć start gościa.
  config.vm.boot_timeout = 600
  config.ssh.insert_key = false
  # ubuntu/jammy64 w tym środowisku akceptuje domyślny klucz RSA Vagranta.
  config.ssh.private_key_path = File.join(
    Dir.home,
    ".vagrant.d",
    "insecure_private_keys",
    "vagrant.key.rsa"
  )

  # Wybieraj fizyczną kartę LAN, a nie adapter VPN (np. NordLynx).
  # Na innym hoście można ją nadpisać: $env:VAGRANT_BRIDGE = "nazwa adaptera"
  bridge_adapter = ENV.fetch("VAGRANT_BRIDGE", "Intel(R) Ethernet Controller (2) I225-V")

  nodes.each do |node|
    node_key_pair = key_pairs.find { |key_pair| key_pair[:name] == node[:name] }
    encoded_node_private_key = Base64.strict_encode64(
      File.read(node_key_pair[:private_key_path], encoding: "UTF-8")
    )

    config.vm.define node[:name] do |machine|
      machine.vm.hostname = node[:hostname]
      machine.vm.network "private_network", ip: node[:ip]
      machine.vm.network "public_network", type: "dhcp", bridge: bridge_adapter, mac: node[:mac]
      machine.vm.provider "virtualbox" do |virtualbox|
        virtualbox.name = "ansible-test-#{node[:name]}"
        virtualbox.cpus = 2
        virtualbox.memory = 2048
        virtualbox.check_guest_additions = false
      end

      machine.vm.provision "shell", inline: <<-SHELL
        set -Eeuo pipefail
        export DEBIAN_FRONTEND=noninteractive

        apt-get update
        apt-get install -y python3 python3-apt

        if ! id -u slawek >/dev/null 2>&1; then
          useradd --create-home --shell /bin/bash slawek
        fi
        usermod --append --groups sudo slawek

        install -d -m 700 -o slawek -g slawek /home/slawek/.ssh
        echo "#{encoded_authorized_keys}" | base64 --decode > /home/slawek/.ssh/authorized_keys
        chown slawek:slawek /home/slawek/.ssh/authorized_keys
        chmod 600 /home/slawek/.ssh/authorized_keys

        install -d -m 700 -o slawek -g slawek /home/slawek/.ssh/ansible-test
        echo "#{encoded_node_private_key}" | base64 --decode > /home/slawek/.ssh/ansible-test/#{node_key_pair[:key_name]}
        chown slawek:slawek /home/slawek/.ssh/ansible-test/#{node_key_pair[:key_name]}
        chmod 600 /home/slawek/.ssh/ansible-test/#{node_key_pair[:key_name]}

        printf '%s\n' 'slawek ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/slawek
        chmod 440 /etc/sudoers.d/slawek
        visudo -cf /etc/sudoers.d/slawek
      SHELL
    end
  end
end
