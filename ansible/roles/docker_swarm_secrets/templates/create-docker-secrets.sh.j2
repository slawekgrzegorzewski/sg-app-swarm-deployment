#!/usr/bin/env bash
set -Eeuo pipefail

mode="${1:-}"
shift || true

declare -A used_secret_names=()
mapfile -t service_ids < <(docker service ls --quiet)
if [[ -n "${service_ids[0]+present}" ]]; then
  while IFS= read -r used_secret_name; do
    [[ -n "$used_secret_name" ]] && used_secret_names["$used_secret_name"]=1
  done < <(
    docker service inspect "${service_ids[@]}" \
      --format '{% raw %}{{range .Spec.TaskTemplate.ContainerSpec.Secrets}}{{println .SecretName}}{{end}}{% endraw %}'
  )
fi

preflight() {
  for name in "$@"; do
    if docker secret inspect "$name" >/dev/null 2>&1 &&
      [[ -n "${used_secret_names[$name]+present}" ]]; then
      printf 'Skipping secret %s: it is used by a Swarm service.\n' "$name" >&2
      continue
    fi

    printf '%s\n' "$name"
  done
}

create_or_update_secret() {
  local name="$1"
  local action='created'

  if docker secret inspect "$name" >/dev/null 2>&1; then
    if [[ -n "${used_secret_names[$name]+present}" ]]; then
      printf 'Cannot update secret %s: it is used by a Swarm service.\n' "$name" >&2
      return 3
    fi

    docker secret rm "$name" >/dev/null
    action='updated'
  fi

  docker secret create "$name" - >/dev/null
  printf '%s %s\n' "$name" "$action"
}

case "$mode" in
  --preflight)
    (($# > 0)) || { echo 'No secret names supplied.' >&2; exit 2; }
    preflight "$@"
    ;;
  --apply)
    (($# == 1)) || { echo 'Exactly one secret name is required.' >&2; exit 2; }
    create_or_update_secret "$1"
    ;;
  *)
    echo "Usage: $(basename "$0") --preflight NAME... | --apply NAME" >&2
    exit 2
    ;;
esac
