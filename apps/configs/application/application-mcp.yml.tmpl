server:
  address: 0.0.0.0
  port: 8080

spring:
  application:
    name: sg-mcp-app
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${MCP_ISSUER_URI:https://auth.grzegorzewski.pl/realms/sg}
          jwk-set-uri: ${spring.security.oauth2.resourceserver.jwt.issuer-uri}/protocol/openid-connect/certs
          audiences:
            - ${mcp.security.resource-uri}
  ai:
    mcp:
      server:
        name: sg-mcp-app
        version: 1.0.0
        instructions: >-
          First call get_current_user. One domain: use it without asking. Multiple domains: ask the user
          and wait for their explicit choice; never choose first/default. No domains: stop.
          Pass the selected domainPublicId to every other tool. Reuse it for related calls until the user changes it.
        protocol: STREAMABLE
        type: SYNC
        capabilities:
          resource: false
          prompt: false
          completion: false

mcp:
  security:
    resource-uri: ${MCP_RESOURCE_URI:https://mcp.grzegorzewski.pl/mcp}

accountant:
  graphql-url: http://backend:8080/graphql
